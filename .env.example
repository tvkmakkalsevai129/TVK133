# ==========================================
# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ==========================================
# CLOUDFLARE R2 CONFIGURATION
# Found in: Cloudflare Dashboard -> R2 -> Manage API Tokens
# ==========================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tvk-complaints-media
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# ==========================================
# APP SECURITY
# Secret key used to verify internal webhooks / cleanup jobs
# ==========================================
INTERNAL_CLEANUP_SECRET=your-random-secure-secret-token
